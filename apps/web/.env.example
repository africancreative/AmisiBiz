# AmisiBiz Environment Variables
# Copy this file to apps/web/.env (git-ignored) and fill in real values.
# Next.js, the Prisma CLI and the seed all load apps/web/.env; Next.js also
# reads apps/web/.env.local for machine-local overrides (takes precedence).
# NEVER commit .env, .env.local or any file containing real secrets.

# ── Application ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AmisiBiz

# ── Tenant hostname routing ────────────────────────────────────
# Base domain for tenant workspaces: tenants are served from
# <slug>.<APP_BASE_DOMAIN> (e.g. acme.amisigenuine.com). NEVER hardcode this.
# Leave unset in local development (hostname routing is then disabled).
# APP_BASE_DOMAIN="amisigenuine.com"
# NEXT_PUBLIC_APP_BASE_DOMAIN="amisigenuine.com"
# Only trust X-Forwarded-Host behind a known reverse proxy / load balancer.
# TRUST_PROXY="false"

# ── Database (Neon PostgreSQL) ──────────────────────────────────
# Neon → Project Dashboard → Connection Details.
# Use the pooled connection for DATABASE_URL and direct connection for DIRECT_URL.
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.[REGION].neon.tech/amisibiz?sslmode=require"
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT].[REGION].neon.tech/amisibiz?sslmode=require"

# ── Runtime database role (optional least-privilege role) ──────
# In production, you can configure a dedicated application role:
# APP_DATABASE_URL="postgresql://amisibiz_app:[PASSWORD]@[ENDPOINT]-pooler.[REGION].neon.tech/amisibiz?sslmode=require"

# ── Authentication (Cryptographic Session Secret) ───────────────
# Secret key used to sign and verify HMAC-SHA256 session cookies.
# Generate a strong 32+ character random secret (e.g. openssl rand -base64 32).
AUTH_SECRET="replace-with-a-secure-random-32-char-string"

# ── Email (required before enabling production registration) ───
# No transport is implemented yet. When EMAIL_PROVIDER is unset, email
# verification and password-reset messages are NOT delivered.
# EMAIL_PROVIDER="smtp"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="noreply@example.com"
# SMTP_PASSWORD="your-smtp-password"
# EMAIL_FROM="AmisiBiz <noreply@amisibiz.com>"

# ── Authentication policy ──────────────────────────────────────
# Enforce email verification at sign-in. Requires a working EMAIL_PROVIDER.
# REQUIRE_EMAIL_VERIFICATION="false"

# ── Seed (optional — platform admin bootstrap) ─────────────────
# Never commit real values. The seed does nothing unless these are set.
# SEED_PLATFORM_ADMIN_EMAIL="admin@example.com"
# SEED_PLATFORM_ADMIN_PASSWORD="a-strong-unique-password-min-12-chars"
# SEED_PLATFORM_ADMIN_NAME="Platform Admin"
# ALLOW_PROD_SEED="false"
