{
  "name": "@amisibiz/web",
  "version": "0.1.0",
  "private": true,
  "description": "AmisiBiz web application — Next.js App Router on Vercel",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:assert-rls": "tsx prisma/scripts/assert-rls.mts",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@amisibiz/auth": "workspace:*",
    "@amisibiz/database": "workspace:*",
    "@amisibiz/domain": "workspace:*",
    "@amisibiz/documents": "workspace:*",
    "@amisibiz/sync": "workspace:*",
    "@amisibiz/ui": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.55.0",
    "next": "^15.3.3",
    "next-intl": "^3.26.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@amisibiz/config": "workspace:*",
    "@eslint/eslintrc": "^3.3.7",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20.17.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.26.0",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
