// This is your Prisma schema file for AmisiBiz
// Multi-tenant SaaS — Amisi Genuine Enterprises
// Phase 1: Foundation — Auth, Tenants, RBAC
//
// Identity note: all primary keys are UUIDs (gen_random_uuid() on the
// database side; application code may supply client-generated UUIDs for the
// offline track). `User` credentials are native (passwordHash) — see the User
// model — and there is no external identity provider.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

// Tenant lifecycle. A tenant is created PENDING (provisioned but not usable),
// moves to ACTIVE only through the authorized platform activation workflow, and
// may be SUSPENDED (data preserved) and later reactivated.
//
// Suspension semantics (Phase 2 owner decision): SUSPENDED denies online WRITES
// and synchronization writes, while READS and downloads of already-issued
// documents keep working for members and portal users. Business rows and
// storage objects are never touched by a suspension, and existing sessions are
// not killed — they become read-only and are refused on their next write. The
// database enforces exactly this (`app_tenant_accepts_writes()` refuses a
// suspended workspace and nothing else).
// PENDING is a workspace that is provisioned but not yet usable: it is enforced
// one layer up, by tenant-context resolution refusing any workspace operation
// while PENDING, because provisioning itself writes into a PENDING row (initial
// settings/branding/domain rows and the owner's invitation acceptance).
enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

// Provider-facing subscription plans. INFORMATIONAL ONLY: no price, no quota,
// no limit and no expiry lives here, because the Phase 2 directive states
// plainly that "the MVP uses manual provider-controlled activation and
// suspension" and forbids suspending a tenant because a payment is overdue.
// A plan label is what an authorized operator records about a commercial
// arrangement; it grants no access and enforces nothing. ARCHIVED plans stay
// readable on the tenants that hold them but cannot be newly assigned.
enum PlanStatus {
  ACTIVE
  ARCHIVED
}

/// Billing state of a tenant subscription. Independent of `Tenant.status`
/// (lifecycle: PENDING/ACTIVE/SUSPENDED). Reform (R5, owner ruling 2026-10-18):
/// replaces the free-text column this enum was written to constrain.
enum SubscriptionStatus {
  ACTIVE
  PAUSED
  TRIAL
  CANCELLED
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
  SUSPENDED
}

// Platform domain — Amisi Genuine internal staff. Kept strictly separate from
// tenant roles: a platform role NEVER grants tenant business data access on
// its own (support staff need an explicit, expiring SupportAccessGrant).
// NULL on User.platformRole means "no platform privileges" (the default).
enum PlatformRole {
  SUPER_ADMIN // Amisi Genuine internal administration
  SUPPORT // Customer support — no permissions without a support grant
}

// Tenant domain — roles within a customer's business workspace (the 9-role
// model of the Phase 1 directive). Deny-by-default: the schema default is the
// least-privileged role.
enum TenantRole {
  TENANT_OWNER // Owns the workspace; sole granter of the owner role
  TENANT_ADMIN // Routine operations, settings and member management (guarded)
  SALES // Contacts, catalogue and quotations
  FINANCE // Invoices, payments and financial exports
  OPERATIONS // Catalogue operations and delivery notes
  VIEWER // Read-only access to explicitly permitted information
  CUSTOMER_PORTAL_USER // Customer portal only; never internal records
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ─── Tenant (Organisation) ────────────────────────────────────────────────────

model Tenant {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // Immutable internal ID
  name     String // Business display name
  slug     String       @unique // URL-safe workspace slug e.g. "acme"
  logoUrl  String?
  status   TenantStatus @default(PENDING) // PENDING until activated
  country  String? // ISO 3166-1 alpha-2
  currency String       @default("KES") // ISO 4217
  timezone String       @default("UTC")
  locale   String       @default("en") // Default locale for tenant
  planId   String?      @db.Uuid // Provider-recorded plan label (informational; never an entitlement)

  // Lifecycle metadata (activation / suspension)
  activatedAt      DateTime?
  activatedById    String?   @db.Uuid
  suspendedAt      DateTime?
  suspendedById    String?   @db.Uuid
  suspensionReason String?

  // Operational indicators (Phase 2 provider console). Written ONLY through the
  // narrow definer functions `touch_tenant_activity` /
  // `record_tenant_sync_attempt`, so no ordinary write path can stamp them and
  // no policy has to be widened to let one. NULL means "never recorded" — which
  // for `lastSyncAt` is the expected state today, because the MVP has no sync
  // transport yet and the console must say so rather than imply freshness.
  // An offline device is invisible until it next connects and is refused.
  lastActivityAt    DateTime?
  lastSyncAt        DateTime?
  lastSyncErrorCode String?

  // Who provisioned the tenant (self-service registration or platform
  // operator). Used by RLS to let a registrant create their own owner
  // membership — and nobody else's.
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  createdBy            User?                    @relation("TenantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  activatedBy          User?                    @relation("TenantActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)
  suspendedBy          User?                    @relation("TenantSuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)
  plan                 Plan?                    @relation("TenantPlan", fields: [planId], references: [id], onDelete: SetNull)
  subscriptions        Subscription[]           @relation("SubscriptionTenant")
  members              TenantMember[]
  invitations          Invitation[]
  auditLogs            AuditLog[]
  statusHistory        TenantStatusHistory[]
  supportGrants        SupportAccessGrant[]
  settings             TenantSettings?
  branding             TenantBranding?
  domains              TenantDomain[]
  contacts             Contact[]
  taxCategories        TaxCategory[]
  taxRates             TaxRate[]
  items                Item[]
  contactItems         ContactItem[]
  documents            Document[]
  documentLines        DocumentLine[]
  documentPayments     DocumentPayment[]
  documentStatusEvents DocumentStatusEvent[]
  documentNumberings   DocumentNumbering[]
  documentSequences    DocumentNumberSequence[]
  // CRM & commerce (AGENT 02)
  catalogueCategories  CatalogueCategory[]
  tags                 Tag[]
  contactTags          ContactTag[]
  itemImages           ItemImage[]
  productVariants      ProductVariant[]
  pipelines            Pipeline[]
  pipelineStages       PipelineStage[]
  leads                Lead[]
  tasks                Task[]
  activityEvents       ActivityEvent[]
  shareLinks           ShareLink[]
  // Social commerce & marketing (AGENT 03)
  integrationConnections   IntegrationConnection[]
  integrationWebhookEvents IntegrationWebhookEvent[]
  conversations            Conversation[]
  conversationMessages     ConversationMessage[]
  conversationNotes        ConversationNote[]
  conversationLabels       ConversationLabel[]
  labels                   Label[]
  quickReplies             QuickReply[]
  marketingEvents          MarketingEvent[]
  marketingCampaigns       MarketingCampaign[]
  contentPosts             ContentPost[]
  publishJobs              PublishJob[]
  mediaAssets              MediaAsset[]
  // Phase 06 server half: idempotency receipts for pushed operations, and the
  // tombstones a hard delete leaves behind so an offline device drops the row
  // instead of keeping a ghost.
  syncOperations       SyncOperation[]
  syncDeletions        SyncDeletion[]

  @@index([slug])
  @@index([status])
  @@index([planId])
  @@index([lastActivityAt])
  @@index([createdById])
  @@index([activatedById])
  @@index([suspendedById])
}

// ─── Subscription plans (provider-side labels) ───────────────────────────────
// Deliberately information-only: the `Plan` catalog carries a code, a display
// name, a description and an ordering, and nothing else. There is no price
// column (billing is not modelled in this product yet), no limit column (no
// feature is gated on a plan) and no status column on any tenant-facing
// behaviour (an overdue arrangement must NEVER auto-suspend — the Phase 2
// directive). Plans are seeded and edited by migrations/operator tooling; the
// runtime role holds SELECT only, and the RLS policy restricts reads to
// platform admins, so a tenant can never enumerate or pick its own plan.

model Plan {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String     @unique // stable machine label, e.g. "standard"
  name        String // display name, e.g. "Amisi Genuine Standard"
  description String
  status      PlanStatus @default(ACTIVE)
  sortOrder   Int        @default(0)

  // Relation is kept for catalogue lookup; active subscription is on the Tenant
  tenants Tenant[] @relation("TenantPlan")
  subscriptions Subscription[] @relation("SubscriptionPlan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
}

/**
 * Subscription — per-tenant billing state.
 *
 * This is the authoritative source for a tenant's subscription state.
 * `status` is independent of `Tenant.status` (lifecycle: PENDING/ACTIVE/SUSPENDED).
 * Payment fields are intentionally opaque: the console never claims payment
 * confirmation from a browser‐initiated response.  Status changes come from
 * verified provider events or a controlled reconciliation process.
 *
 * The RLS policies mirror this: reads are tenant-scoped (a workspace can see
 * its own billing state from any status); writes are platform-admin only
 * (`is_platform_admin()`), the history table is append-only, and no DELETE
 * grant exists for the runtime role — subscriptions end as ARCHIVED, not
 * deleted.
 */
model Subscription {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String             @db.Uuid // Unique: one subscription per tenant
  planId             String             @db.Uuid // Plan from the catalogue
  status             SubscriptionStatus // ACTIVE, PAUSED, TRIAL, CANCELLED, ARCHIVED
  currentPeriodStart DateTime? // Start of the current billing period
  currentPeriodEnd   DateTime? // End of the current billing period
  trialStart         DateTime? // When the trial period began (if any)
  trialEnd           DateTime? // When the trial period ends (if any)
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  tenant Tenant @relation("SubscriptionTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  // RESTRICT, deliberately: a plan that subscriptions still reference cannot be
  // deleted from the catalogue (the pre-reform `onDelete: SetNull` collided with
  // the NOT NULL column — a delete would have failed as a constraint violation).
  plan   Plan   @relation("SubscriptionPlan", fields: [planId], references: [id], onDelete: Restrict)
  statusHistory SubscriptionStatusHistory[] @relation("SubscriptionStatusHistory")

  @@unique([tenantId])
  @@index([status])
  @@index([planId])
}

/**
 * Subscription status history — append‑only audit trail.
 *
 * Every status change (ACTIVE → PAUSED, TRIAL → ACTIVE, etc.) is recorded
 * here so that the console can display a changelog and operators can
 * investigate billing decisions.  The `changedBy` field references the
 * platform administrator who triggered the change.
 */
model SubscriptionStatusHistory {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId String             @db.Uuid
  fromStatus     SubscriptionStatus? // Previous status before the change
  toStatus       SubscriptionStatus // New status after the change
  changedBy      String?            @db.Uuid // Platform administrator who triggered the change
  reason         String?            // Business justification — optional but recommended
  createdAt      DateTime           @default(now())

  subscription Subscription @relation("SubscriptionStatusHistory", fields: [subscriptionId], references: [id], onDelete: Cascade)
  // SET NULL: history must survive the administrator's account being removed.
  changedByUser User?       @relation("SubscriptionStatusChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([createdAt])
}

// ─── Tenant settings (per-tenant configuration) ───────────────────────────────
// Initialised with defaults on provisioning.
//
// Document numbering deliberately does NOT live here any more. The Phase 03
// stub (`documentPrefix` / `documentNextNumber` / `quotationPrefix`) was a single
// counter that could not hold a series per document type and per period, so it
// has been replaced by `DocumentNumbering` + `DocumentNumberSequence`. Keeping
// both would have meant two sources of truth for an authoritative number.

model TenantSettings {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @unique @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Tenant branding (used on the tenant's own documents only) ────────────────

model TenantBranding {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String   @unique @db.Uuid
  displayName         String? // Business display name shown on documents
  registeredName      String? // Registered legal name
  primaryColor        String   @default("#1d4ed8") // Brand primary color (hex)
  secondaryColor      String   @default("#1e3a5f") // Brand secondary color (hex)
  accentColor         String   @default("#f59e0b") // Brand accent color (hex)
  primaryForeground   String   @default("#f8fafc") // Foreground text color (hex)
  logoUrl             String? // URL to stored logo (object storage or local uploads)
  contactEmail        String? // Contact email displayed on documents
  contactPhone        String? // Contact phone displayed on documents
  postalAddress       String? // Postal address for documents
  physicalAddress     String? // Physical address for documents
  website             String? // Website URL
  taxPin              String? // Tax identification number
  currency            String   @default("KES") // ISO 4217 currency code
  defaultFooter       String? // Default footer text on documents
  paymentInstructions String? // Bank details / M-Pesa / payment terms shown on documents
  documentLayout      String   @default("standard") // Document layout model
  
  // Invoice template settings
  invoiceTemplate     String   @default("standard") // Invoice template model
  invoiceCustomizations Json? // Custom JSON for invoice template overrides
  
  // Quotation template settings
  quotationTemplate   String   @default("standard") // Quotation template model
  quotationCustomizations Json? // Custom JSON for quotation template overrides
  
  // Delivery note template settings
  deliveryNoteTemplate String   @default("standard") // Delivery note template model
  deliveryNoteCustomizations Json? // Custom JSON for delivery note template overrides
  
  // Document numbering preferences
  documentNumberingPrefix String   @default("") // Custom prefix for document numbers
  documentNumberingPadding Int      @default(4) // Zero-padding digits for document numbers
  documentPeriodStyle     String   @default("CALENDAR_YEAR") // Period style for numbering
  fiscalStartMonth        Int      @default(1) // Fiscal year start month (1=January)
  
  // eTIMS integration compatibility (future)
  etimsCompatible      Boolean  @default(false) // Flag for eTIMS compatibility
  etimsDocumentType    String? // eTIMS document type code
  etimsSerialNumber    String? // eTIMS serial number (if applicable)
  etimsLastSync        DateTime? // Last eTIMS synchronization timestamp
  
  // Provider configuration (per-tenant settings that work with global admin config)
  // Cloudinary upload preset per tenant (for organized asset storage)
  cloudinaryPresetName String? // Cloudinary preset name for this tenant's assets
  // DPO integration status per tenant
  dpoIntegrationStatus String? // DPO integration status: "pending", "active", "error"
  // Mailtrap from email for this tenant's emails
  mailtrapFromEmail String? // From email address for tenant communications
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Tenant hostname mapping (subdomain routing) ──────────────────────────────
// Maps a full hostname (e.g. "acme.amisigenuine.com") to a tenant. Multiple
// hostnames may map to one tenant; exactly one should be primary.

model TenantDomain {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @db.Uuid
  hostname   String    @unique
  isPrimary  Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([hostname])
}

// ─── Tenant status history (append-only lifecycle log) ────────────────────────
// One row per lifecycle transition (created PENDING, activated, suspended,
// reactivated). `changedById` is null for system transitions.

model TenantStatusHistory {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @db.Uuid
  fromStatus  TenantStatus?
  toStatus    TenantStatus
  changedById String?       @db.Uuid
  reason      String?
  createdAt   DateTime      @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  changedBy User?  @relation("TenantStatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

// ─── Permission catalogue (RLS/RBAC parity with the code matrix) ──────────────
// The permission catalogue and role→permission matrix are defined in code
// (`packages/auth/src/permissions.ts`) and mirrored into these tables by
// migration. An integration test asserts the two are identical in both
// directions, so the database copy can never silently drift.

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique // e.g. "contacts.read", "platform.tenants.activate"
  domain      String // "platform" | "tenant"
  area        String // e.g. "contacts", "documents.invoice", "tenants"
  description String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([domain])
  @@index([area])
}

model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleKey      String // enum member name, e.g. "TENANT_OWNER", "SUPER_ADMIN"
  domain       String // "platform" | "tenant"
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleKey, permissionId])
  @@index([roleKey])
  @@index([permissionId])
}

// ─── Provider support access grants ───────────────────────────────────────────
// Provider support staff hold no tenant permissions by default. Access to a
// tenant's business data is only possible through an explicit grant created
// by a platform super admin: time-boxed (expiresAt), revocable (revokedAt) and
// audited on every use. Grants confer read-only access (enforced at the
// database level as well — support never gets the write policy path).

model SupportAccessGrant {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @db.Uuid
  platformUserId String    @db.Uuid
  grantedById    String?   @db.Uuid
  reason         String // Business justification — required, never empty
  // Windows are instants, not wall-clock times: `has_support_grant()` compares
  // `expiresAt` against `now()`, so these columns must be timezone-independent.
  // See migrations/20261021000001 and docs/architecture/security-model.md §13.7.
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platformUser User   @relation("SupportGrantsReceived", fields: [platformUserId], references: [id], onDelete: Cascade)
  grantedBy    User?  @relation("SupportGrantsIssued", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([platformUserId])
  @@index([platformUserId, tenantId])
}

// ─── Contact types ────────────────────────────────────────────────────────────

enum ContactType {
  INDIVIDUAL
  BUSINESS
}

enum ContactStatus {
  ACTIVE
  ARCHIVED
}

// ─── CRM / commerce types (AGENT 02) ─────────────────────────────────────────
// Capture-channel vocabulary shared by leads and customers. `Contact.source`
// reuses `LeadSource` deliberately: one vocabulary, not two that can drift.
enum LeadSource {
  WEB_FORM
  REFERRAL
  SOCIAL
  CAMPAIGN
  WALK_IN
  PHONE
  EMAIL
  IMPORT
  OTHER
}

// CONVERTED and LOST are terminal.
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

// Shared by leads and tasks (TaskPriority = LeadPriority in the design spec).
enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum ContactChannel {
  PHONE
  WHATSAPP
  SMS
  EMAIL
  PORTAL
  OTHER
}

// `ActivityEvent.eventType` is deliberately a String (open vocabulary —
// LEAD_CREATED, ORDER_CREATED, MERGE_APPLIED, …) so future agents never have to
// migrate an enum for every new event, unlike this closed set.
enum ShareLinkKind {
  PRODUCT
  LEAD_FORM
  ORDER_STATUS
}

// Catalogue variant availability. Kept separate from `ItemStatus`: a variant is
// never ARCHIVED — archiving is an item-level decision.
enum VariantStatus {
  ACTIVE
  INACTIVE
}

// ─── Social commerce & marketing types (AGENT 03) ─────────────────────────────
// Provider identity is the Meta channel a connection represents; a single
// `IntegrationConnection` is one (tenant, provider) pair.
enum IntegrationProvider {
  META_WHATSAPP
  META_FB_PAGE
  META_INSTAGRAM
}

// Connection lifecycle. UNVERIFIED is the freshly-created row before the
// verifyConnection probe; ERROR means the last probe failed (AUTH class) and
// outbound is refused. DISCONNECTED deletes the credential ciphertext but keeps
// history.
enum ConnectionStatus {
  UNVERIFIED
  PENDING_VERIFICATION
  CONNECTED
  DISCONNECTED
  ERROR
}

// A raw webhook event's routing state. PARKED means authentic but not yet
// resolvable to a tenant; APPLIED means it has been fanned out; IGNORED means a
// forged/duplicate event kept only for the audit trail.
enum WebhookRoutingStatus {
  PARKED
  APPLIED
  IGNORED
}

// The messaging surface a conversation lives on. Deliberately separate from
// IntegrationProvider: a META_FB_PAGE connection can carry both a Page post and
// a Messenger conversation.
enum ConversationChannel {
  WHATSAPP
  MESSENGER
  INSTAGRAM
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

// Message direction. INTERNAL notes are NOT a direction — they are their own
// table (ConversationNote), so this enum never carries an internal member.
enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// Event tracking vocabulary. The emitters are the share-link resolver, the
// capture API and the AGENT 02 mutation services, all through the single
// `appendMarketingEvent` writer.
enum MarketingEventType {
  CAMPAIGN_LINK_CLICK
  PRODUCT_PAGE_VIEW
  ENQUIRY_SUBMITTED
  LEAD_CREATED
  QUOTATION_ACCEPTED
  ORDER_CREATED
  PAYMENT_VERIFIED
  ORDER_FULFILLED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

// Content publishing channel. WhatsApp has no post surface, so this is narrower
// than the messaging channel enum on purpose.
enum ContentPostChannel {
  FACEBOOK_PAGE
  INSTAGRAM
}

enum ContentKind {
  POST
  STORY
  REEL
}

// Drafting and publishing are separate objects: a ContentPost walks
// DRAFT → IN_REVIEW → APPROVED/REJECTED, then SCHEDULED, and only a `verified`
// PublishJob outcome flips it to PUBLISHED. A draft is never rendered published.
enum ContentPostStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHED
  PUBLISH_FAILED
}

enum PublishJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  ABANDONED
}

// Classified publish failures. AUTH stops the retry ladder immediately (a
// revoked credential must not be retried into the provider); the rest walk the
// 1m/5m/25m/2h/6h ladder before ABANDONED.
enum PublishErrorClass {
  AUTH
  RATE_LIMIT
  PERMISSION
  CONTENT
  NETWORK
  UNKNOWN
}

enum MediaAssetKind {
  IMAGE
  VIDEO
}

// ─── Tax configuration (explicit, not implicit) ───────────────────────────────

model TaxCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  name        String // e.g. "VAT", "WHT", "EXEMPT"
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rates  TaxRate[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model TaxRate {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @db.Uuid
  categoryId    String    @db.Uuid
  name          String // e.g. "VAT 16%"
  rate          Decimal   @db.Decimal(5, 4) // e.g. 0.1600 for 16%
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      TaxCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items         Item[]
  documentLines DocumentLine[]
  variants      ProductVariant[]

  @@unique([tenantId, categoryId, name, effectiveFrom])
  @@index([tenantId])
  @@index([categoryId])
  @@index([effectiveFrom])
}

// ─── Contacts CRM ─────────────────────────────────────────────────────────────

model Contact {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @db.Uuid
  type        ContactType   @default(INDIVIDUAL)
  status      ContactStatus @default(ACTIVE)
  firstName   String?
  lastName    String?
  companyName String?
  email       String?
  phone       String?
  mobile      String?
  taxPin      String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  archivedAt  DateTime?
  // Monotonic server revision. Bumped by the `amisibiz_bump_revision` trigger on
  // every UPDATE. It is the ordering authority an offline pull compares against,
  // never a device clock.
  revision    Int           @default(1)

  // ── Capture channel & marketing consent (AGENT 02) ────────────────────────
  // `source` reuses the LeadSource vocabulary; `sourceCampaign` is UTM text —
  // campaign entities are AGENT 04 territory, no Campaign table exists here.
  source            LeadSource      ?
  sourceDetail      String?
  sourceCampaign    String?
  preferredChannel  ContactChannel?
  marketingConsent  Boolean         @default(false)
  marketingConsentAt DateTime?
  // Merge survivor pointer: a merged-away contact keeps its row (never hard
  // deleted), is set ARCHIVED, and points at the surviving contact here.
  supersededById    String?         @db.Uuid

  // ── Customer-portal linkage ──────────────────────────────────────────────
  // A portal user is an ordinary `User` whose `TenantMember.role` is
  // CUSTOMER_PORTAL_USER. Linking that user here is the WHOLE of their access:
  // the portal download route resolves this row and then refuses any document
  // whose `contactId` is not this contact, so a portal user can only ever see
  // their own documents. Revoking portal access is setting this back to NULL.
  portalUserId String? @db.Uuid
  portalUser   User?   @relation("ContactPortalAccess", fields: [portalUserId], references: [id], onDelete: SetNull)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses    ContactAddress[]
  contactItems ContactItem[]
  documents    Document[] // Future: document history

  // ── CRM relations (AGENT 02) ─────────────────────────────────────────────
  supersedes     Contact[]       @relation("ContactMerge")
  supersededBy   Contact?        @relation("ContactMerge", fields: [supersededById], references: [id], onDelete: SetNull)
  leads          Lead[]
  convertedLeads Lead[]          @relation("LeadConvertedContact")
  tasks          Task[]
  contactTags    ContactTag[]
  activityEvents ActivityEvent[]
  // Social commerce (AGENT 03): a contact is the customer behind a conversation
  // and the identity a consented marketing event may attach to.
  conversations    Conversation[]
  marketingEvents  MarketingEvent[]

  @@unique([tenantId, portalUserId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, companyName])
  @@index([tenantId, createdAt])
  @@index([tenantId, source])
}

model ContactAddress {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId  String   @db.Uuid
  type       String // "POSTAL" | "PHYSICAL"
  line1      String
  line2      String?
  city       String?
  state      String?
  postalCode String?
  country    String? // ISO 3166-1 alpha-2
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([contactId, type])
}

// ─── Items & Services Catalogue ───────────────────────────────────────────────

enum ItemType {
  PRODUCT
  SERVICE
}

enum ItemStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Item {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String     @db.Uuid
  type          ItemType   @default(PRODUCT)
  status        ItemStatus @default(ACTIVE)
  name          String
  sku           String?
  description   String?
  unitOfMeasure String     @default("each")
  unitPrice     Decimal    @db.Decimal(18, 4) // Minor-unit model: stored as major units with 4dp precision
  currency      String     @default("KES")
  taxRateId     String?    @db.Uuid
  categoryId    String?    @db.Uuid
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  // Monotonic server revision, maintained by the `amisibiz_bump_revision`
  // trigger (see Contact.revision).
  revision      Int        @default(1)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxRate       TaxRate?            @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  category      CatalogueCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  contactItems  ContactItem[]
  documentLines DocumentLine[]
  images        ItemImage[]
  variants      ProductVariant[]
  shareLinks    ShareLink[]
  marketingEvents MarketingEvent[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, name])
  @@index([tenantId, categoryId])
}

// ─── Customer-specific item catalogue ─────────────────────────────────────────

model ContactItem {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @db.Uuid
  contactId           String    @db.Uuid
  itemId              String    @db.Uuid
  customCode          String? // Customer-specific item code
  customName          String? // Customer-specific description
  customUnitOfMeasure String? // Customer-specific unit of measure
  agreedPrice         Decimal   @db.Decimal(18, 4) // Override price for this customer
  discountPercent     Decimal   @default(0) @db.Decimal(5, 2) // e.g. 10.00 for 10%
  isAvailable         Boolean   @default(true)
  // Agreement validity window. Either bound may be open; the agreement is only
  // applied to a new line whose date falls inside it. A missing window means the
  // agreement does not expire.
  validFrom           DateTime?
  validUntil          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  // Monotonic server revision, maintained by the `amisibiz_bump_revision`
  // trigger (see Contact.revision).
  revision            Int       @default(1)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, contactId, itemId])
  @@index([tenantId])
  @@index([tenantId, contactId])
  @@index([tenantId, itemId])
}

// ─── Documents (Phase 05) ─────────────────────────────────────────────────────
//
// One table carries all three sales document types because they share almost
// everything: numbering, tenant scoping, line snapshots, totals, issuance and
// audit. What differs is expressed as data — `type`, the allowed status set and
// the date fields that apply — never as three parallel tables that can drift
// apart.
//
// Two invariants the whole module rests on:
//
//   1. A DRAFT is editable and has no number. The number is allocated inside the
//      issuance transaction, so abandoned or deleted drafts never burn a number
//      and an issued number is never reused.
//   2. An ISSUED document is immutable. Its lines, prices, tax, totals, branding
//      and customer details are frozen (`snapshot`) at issuance, and a database
//      trigger refuses any write that would change a financially material field.
//      Corrections happen by voiding or by issuing a replacement that keeps the
//      original row.

enum DocumentType {
  QUOTATION
  INVOICE
  DELIVERY_NOTE
  // Orders are `Document` rows of this type — not a new entity (design spec §0).
  // ORDER uses the pre-existing statuses DRAFT, ISSUED, PARTIALLY_PAID, PAID,
  // OVERDUE, CANCELLED, VOID; no new DocumentStatus values are needed.
  ORDER
}

// The union of all three lifecycles. Which subset applies to a given type is
// enforced by a CHECK constraint in the database and by the state machine in
// `src/server/services/documents/lifecycle.ts` — never by the status arriving
// from the browser.
enum DocumentStatus {
  DRAFT
  ISSUED
  ACCEPTED // QUOTATION
  REJECTED // QUOTATION
  EXPIRED // QUOTATION
  CANCELLED // QUOTATION, DELIVERY_NOTE
  PARTIALLY_PAID // INVOICE, derived from recorded payments
  PAID // INVOICE, derived from recorded payments
  OVERDUE // INVOICE
  VOID // INVOICE
  PARTIALLY_DELIVERED // DELIVERY_NOTE source accounting
  DELIVERED // DELIVERY_NOTE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CARD
  CHEQUE
  OTHER
}

enum DocumentDiscountType {
  PERCENT
  AMOUNT
}

// How a document series restarts. `NONE` gives one ever-increasing series per
// tenant and type; calendar and financial years give a fresh series each period,
// which is what the prefix examples in the brief (`INV-2026-0001`) describe.
enum DocumentPeriodStyle {
  NONE
  CALENDAR_YEAR
  FINANCIAL_YEAR
}

model Document {
  id       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String         @db.Uuid
  type     DocumentType
  status   DocumentStatus @default(DRAFT)
  // Null while the document is a draft; allocated on issuance.
  number   String?
  currency String         @default("KES")

  contactId        String? @db.Uuid
  sourceDocumentId String? @db.Uuid // quotation -> invoice, sales document -> delivery note
  replacementOfId  String? @db.Uuid // correction document that replaces a voided one
  // Client-supplied key that makes a retried conversion/issue return the same
  // document instead of creating a second one.
  idempotencyKey   String?

  // ── Dates. `issuedAt` is when the document was issued (system time);
  // `issueDate` is the date printed on it — a back-dated invoice is a business
  // decision, so both are kept.
  issueDate    DateTime  @default(now())
  dueDate      DateTime?
  expiryDate   DateTime?
  deliveryDate DateTime?
  deliveryNote String?
  issuedAt     DateTime?
  issuedById   String?   @db.Uuid
  voidedAt     DateTime?
  voidReason   String?
  voidedById   String?   @db.Uuid

  // ── Customer-facing text
  customerNote String?
  terms        String?

  // ── Stored breakdown (see `documents/calculations.ts`). Consistency between
  // these five columns is a database CHECK, not a convention.
  subtotal       Decimal @default(0) @db.Decimal(18, 4)
  totalDiscount  Decimal @default(0) @db.Decimal(18, 4)
  taxableBase    Decimal @default(0) @db.Decimal(18, 4)
  taxTotal       Decimal @default(0) @db.Decimal(18, 4)
  total          Decimal @default(0) @db.Decimal(18, 4)
  // Per-rate grouping, e.g. [{ name: "VAT 16%", rate: "0.1600", base: "...", amount: "..." }]
  taxBreakdown   Json?
  // Rounding policy applied when the totals were computed, recorded so a
  // document issued under a future policy change stays reproducible.
  roundingPolicy String  @default("half-up-per-line-v1")

  // Frozen business/customer/line data captured at issuance. The PDF renders
  // from this, so later contact, branding or catalogue edits cannot rewrite an
  // issued document.
  snapshot   Json?
  snapshotAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Monotonic server revision, maintained by the `amisibiz_bump_revision`
  // trigger (see Contact.revision).
  revision  Int      @default(1)

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact          Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  sourceDocument   Document?             @relation("DocumentDerivation", fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  derivedDocuments Document[]            @relation("DocumentDerivation")
  replacementOf    Document?             @relation("DocumentReplacement", fields: [replacementOfId], references: [id], onDelete: Restrict)
  replacements     Document[]            @relation("DocumentReplacement")
  issuedBy         User?                 @relation("DocumentIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  voidedBy         User?                 @relation("DocumentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  lines            DocumentLine[]
  payments         DocumentPayment[]
  statusEvents     DocumentStatusEvent[]
  // ── CRM / commerce relations (AGENT 02)
  convertedByLeads Lead[]                @relation("LeadConvertedDocument")
  tasks            Task[]
  activityEvents   ActivityEvent[]
  shareLinks       ShareLink[]
  marketingEvents  MarketingEvent[]

  @@unique([tenantId, type, number])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, contactId])
  @@index([tenantId, status])
  @@index([tenantId, type, status])
  @@index([tenantId, issuedAt])
  @@index([tenantId, dueDate])
  @@index([tenantId, sourceDocumentId])
}

model DocumentLine {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @db.Uuid
  documentId String @db.Uuid
  position   Int

  // Provenance only — the printed line always comes from the snapshot columns
  // below, never from the current catalogue.
  itemId       String? @db.Uuid
  // Variant provenance follows the same rule as `itemId`: snapshot columns remain
  // the print authority.
  variantId    String? @db.Uuid
  // For a delivery note, the source document line this line delivers against.
  sourceLineId String? @db.Uuid

  description   String
  itemCode      String?
  unitOfMeasure String  @default("each")

  quantity        Decimal               @db.Decimal(18, 4)
  unitPrice       Decimal               @db.Decimal(18, 4)
  discountType    DocumentDiscountType?
  discountPercent Decimal               @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal               @default(0) @db.Decimal(18, 4)
  lineTotal       Decimal               @db.Decimal(18, 4) // quantity x price, rounded
  lineDiscount    Decimal               @default(0) @db.Decimal(18, 4)
  lineNet         Decimal               @db.Decimal(18, 4) // lineTotal - lineDiscount
  lineTax         Decimal               @default(0) @db.Decimal(18, 4)

  // Tax snapshot. `taxRateId` records where the rate came from; the fraction and
  // label are copied so a retired rate cannot change an old document.
  taxRateId String? @db.Uuid
  taxName   String?
  taxRate   Decimal @default(0) @db.Decimal(5, 4)

  // Running total delivered against this line (source documents only).
  deliveredQuantity Decimal @default(0) @db.Decimal(18, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  item       Item?           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  taxRateRef TaxRate?        @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  sourceLine DocumentLine?   @relation("DeliveryAgainst", fields: [sourceLineId], references: [id], onDelete: Restrict)
  deliveries DocumentLine[]  @relation("DeliveryAgainst")

  @@unique([tenantId, documentId, position])
  @@index([tenantId])
  @@index([tenantId, itemId])
}

model DocumentPayment {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @db.Uuid
  documentId String @db.Uuid

  amount     Decimal       @db.Decimal(18, 4)
  occurredOn DateTime
  method     PaymentMethod @default(BANK_TRANSFER)
  reference  String?
  note       String?
  // Reversing a payment never deletes it: the row stays with its reversal
  // metadata so the balance history is auditable.
  reversedAt DateTime?
  reversedBy String?       @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document       Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  reversedByUser User?    @relation("DocumentPaymentReversedBy", fields: [reversedBy], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, documentId])
  @@index([tenantId, occurredOn])
}

// Append-only transition log: who moved which document to which status, when,
// and why. This is the audit trail the lifecycle needs on top of `AuditLog`.
model DocumentStatusEvent {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String @db.Uuid
  documentId String @db.Uuid

  fromStatus DocumentStatus?
  toStatus   DocumentStatus
  reason     String?
  actorId    String?         @db.Uuid

  createdAt DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor    User?    @relation("DocumentStatusEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, documentId])
  @@index([tenantId, createdAt])
}

// ─── Document numbering configuration and counters ────────────────────────────

// One row per tenant per document type: what the number looks like.
model DocumentNumbering {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String       @db.Uuid
  type     DocumentType

  prefix           String              @default("")
  padding          Int                 @default(4)
  separator        String              @default("-")
  periodStyle      DocumentPeriodStyle @default(CALENDAR_YEAR)
  // Only read when periodStyle is FINANCIAL_YEAR: the month the tenant's books
  // start in (1 = January). A financial year is written "2026/27", i.e. the
  // calendar year it begins in.
  fiscalStartMonth Int                 @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sequences DocumentNumberSequence[]

  @@unique([tenantId, type])
  @@index([tenantId])
}

// The counter itself, one row per (tenant, type, period). Allocation happens in
// `allocate_document_number()` under `SELECT ... FOR UPDATE`, which is what makes
// concurrent issuing safe; the unique index on the document number is the
// backstop if the lock is ever bypassed.
model DocumentNumberSequence {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String       @db.Uuid
  type      DocumentType
  // e.g. "2026" (calendar), "2026/27" (financial) or "" (no period).
  period    String       @default("")
  nextValue Int          @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  numbering DocumentNumbering @relation(fields: [tenantId, type], references: [tenantId, type], onDelete: Cascade)

  @@unique([tenantId, type, period])
  @@index([tenantId])
}

// ─── CRM & commerce (AGENT 02 Phase 1) ────────────────────────────────────────
//
// Leads/pipeline, tasks, the unified activity timeline, share links and the
// catalogue extensions (categories, tags, images, variants). Governing rules
// from the design spec:
//
//   - Orders are `Document` rows of type ORDER — there is no `Order` table here.
//   - Public unauthenticated access happens only through SECURITY DEFINER
//     functions (migration side); nothing anonymous reads these tables directly.
//   - `ActivityEvent` is the single unified timeline: append-only, open
//     vocabulary `eventType`, and `(tenantId, source, sourceKey)` uniqueness
//     makes a retried write land once.
//   - Duplicate detection never merges automatically; `Contact.supersededById`
//     is set only by the explicit two-step merge action.
//   - `ShareLink.token` is generated server-side (base62, ≥24 chars) and is a
//     resource key, never a tenant-routing key.

model CatalogueCategory {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String  @db.Uuid
  name     String
  parentId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   CatalogueCategory?  @relation("CatalogueCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children CatalogueCategory[] @relation("CatalogueCategoryTree")
  items    Item[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, parentId])
}

model Tag {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  name     String

  createdAt DateTime @default(now())

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactTags ContactTag[]

  // The migration additionally enforces case-insensitive uniqueness via a
  // functional unique index on lower(name); Prisma cannot express that here.
  @@unique([tenantId, name])
  @@index([tenantId])
}

// Junction table. It carries its own tenantId because the RLS policy template
// keys on `"tenantId"` directly (same pattern as DocumentLine/DocumentPayment);
// a migration trigger asserts the tenant matches both parents.
model ContactTag {
  tenantId  String   @db.Uuid
  contactId String   @db.Uuid
  tagId     String   @db.Uuid
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tenantId])
  @@index([tagId])
  @@index([tenantId, tagId])
}

// Images are stored through the provider's Vercel Blob seam
// (`lib/logo-storage.ts` pattern, `BLOB_READ_WRITE_TOKEN` fail-closed);
// `blobUrl` is the resulting public blob read URL. No fake local storage.
model ItemImage {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @db.Uuid
  itemId   String @db.Uuid
  position Int
  blobUrl  String
  alt      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([tenantId, itemId, position])
  @@index([tenantId])
  @@index([tenantId, itemId])
}

model ProductVariant {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String        @db.Uuid
  itemId    String        @db.Uuid
  name      String
  sku       String?
  unitPrice Decimal       @db.Decimal(18, 4) // Minor-unit model, as on Item
  currency  String        @default("KES")
  taxRateId String?       @db.Uuid
  status    VariantStatus @default(ACTIVE)
  position  Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item          Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  taxRate       TaxRate?       @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  documentLines DocumentLine[]

  // Plain unique: Postgres treats NULLs as distinct, so variants without a SKU
  // are unconstrained — the partial-index behaviour the spec asks for.
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, itemId])
}

model Pipeline {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  // One default per tenant, enforced in the migration by a partial unique
  // `(tenantId) WHERE "isDefault" AND "archivedAt" IS NULL`.
  isDefault Boolean   @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stages PipelineStage[]

  @@index([tenantId])
}

model PipelineStage {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @db.Uuid
  pipelineId String  @db.Uuid
  name       String
  position   Int
  // Terminal markers for win/loss metrics — a stage is won, lost, or neither.
  isWin      Boolean @default(false)
  isLost     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([tenantId, pipelineId, position])
  @@index([tenantId])
  @@index([tenantId, pipelineId])
}

model Lead {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String       @db.Uuid
  status            LeadStatus   @default(NEW)
  priority          LeadPriority @default(MEDIUM)
  pipelineStageId   String?      @db.Uuid
  assignedToUserId  String?      @db.Uuid
  firstName         String?
  lastName          String?
  companyName       String?
  email             String?
  phone             String?
  description       String?
  currency          String       @default("KES")
  estimatedValue    Decimal?     @db.Decimal(18, 4)
  source            LeadSource
  sourceDetail      String?
  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  // Existing-customer link (a lead that references a known contact).
  contactId         String?      @db.Uuid
  lostReason        String?
  lostAt            DateTime?
  convertedAt       DateTime?
  convertedContactId  String?    @db.Uuid
  // The quotation/order the conversion produced, when one was created.
  convertedDocumentId String?    @db.Uuid
  idempotencyKey    String?
  externalId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Monotonic server revision. Bumped by the `amisibiz_bump_revision` trigger on
  // every UPDATE. It is the ordering authority an offline pull compares against,
  // never a device clock. (Trigger arrives with migration 24.)
  revision  Int      @default(1)

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipelineStage     PipelineStage?   @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  assignedToUser    User?            @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  contact           Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  convertedContact  Contact?         @relation("LeadConvertedContact", fields: [convertedContactId], references: [id], onDelete: SetNull)
  convertedDocument Document?        @relation("LeadConvertedDocument", fields: [convertedDocumentId], references: [id], onDelete: SetNull)
  tasks             Task[]
  activityEvents    ActivityEvent[]
  conversations     Conversation[]
  marketingEvents   MarketingEvent[]

  // "Prevent duplicate leads from retries": plain uniques — Postgres NULLS
  // DISTINCT gives the partial-index behaviour the spec describes.
  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, source, externalId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, email])
  @@index([tenantId, phone])
}

model Task {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @db.Uuid
  title       String
  notes       String?
  dueAt       DateTime?
  completedAt DateTime?
  // TaskPriority = LeadPriority (shared enum, per the design spec).
  priority    LeadPriority  @default(MEDIUM)
  assigneeId  String?       @db.Uuid
  // A task always belongs to something: the migration-side CHECK requires at
  // least one of leadId / contactId / documentId.
  leadId      String?       @db.Uuid
  contactId   String?       @db.Uuid
  documentId  String?       @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Monotonic server revision, maintained by the `amisibiz_bump_revision`
  // trigger (see Lead.revision; trigger arrives with migration 24).
  revision  Int      @default(1)

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee User?          @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  lead     Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact  Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  document Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)

  activityEvents ActivityEvent[]

  @@index([tenantId])
  @@index([tenantId, dueAt])
  @@index([tenantId, contactId])
  @@index([tenantId, leadId])
}

// Unified activity timeline. APPEND-ONLY: no `updatedAt` by design — the
// migration grants SELECT+INSERT only and a BEFORE UPDATE/DELETE trigger
// refuses writes, mirroring `document_status_event_is_append_only`.
model ActivityEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  // Open vocabulary: LEAD_CREATED, ORDER_CREATED, MERGE_APPLIED, …
  eventType   String
  occurredAt  DateTime @default(now())
  actorId     String?  @db.Uuid
  leadId      String?  @db.Uuid
  contactId   String?  @db.Uuid
  documentId  String?  @db.Uuid
  taskId      String?  @db.Uuid
  shareLinkId String?  @db.Uuid
  payload     Json?
  // Retry-dedup identity: a writer names itself (`source`) and keys the exact
  // mutation (`sourceKey`); the unique index below makes a retry land once.
  source      String?
  sourceKey   String?

  createdAt DateTime @default(now())

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  lead      Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact   Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  document  Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  task      Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)
  shareLink ShareLink?  @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)

  @@unique([tenantId, source, sourceKey])
  @@index([tenantId])
  @@index([tenantId, occurredAt])
  @@index([tenantId, contactId])
  @@index([tenantId, leadId])
  @@index([tenantId, documentId])
}

// Public share links (`/s/[token]`). The token resolves server-side to this
// row, which carries the tenantId — share links are a resource route, never
// tenant routing. Partial per-kind uniques are enforced in the migration
// ((tenantId,itemId) WHERE PRODUCT AND active; (tenantId,documentId) WHERE
// ORDER_STATUS AND active).
model ShareLink {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String         @db.Uuid
  kind        ShareLinkKind
  // 26-char base62, generated server-side, never client-supplied.
  token       String         @unique
  itemId      String?        @db.Uuid
  documentId  String?        @db.Uuid
  active      Boolean        @default(true)
  expiresAt   DateTime?
  message     String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  // The campaign this link belongs to (AGENT 03). Nullable SetNull: archiving a
  // campaign never eats an already-distributed link. UTM text stays the
  // attribution authority; campaignId is the structured grouping.
  campaignId  String?        @db.Uuid
  // Bumped only by the public resolver function (retry double-count tolerated
  // and documented — no client-supplied attribution).
  viewCount   Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item   Item?  @relation(fields: [itemId], references: [id], onDelete: SetNull)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  campaign MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  activityEvents  ActivityEvent[]
  marketingEvents MarketingEvent[]

  @@index([tenantId])
  @@index([tenantId, kind])
  @@index([tenantId, campaignId])
}

// ─── User profile (identity authority: native credentials) ────────────────────────

// Identity authority is this table. Credentials are native: `passwordHash`
// (bcrypt) authenticates the user and `sessionVersion` is the revocation
// counter read by the session trust chain. `id` is generated here
// (gen_random_uuid()); there is no external identity provider.
model User {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String?
  email          String        @unique
  emailVerified  DateTime?
  image          String?
  // NULL = no platform privileges (the default). Platform roles never grant
  // tenant business data access on their own.
  platformRole   PlatformRole?
  status         UserStatus    @default(ACTIVE)
  passwordHash   String?
  // Monotonic revocation version. A session token is valid only while its
  // embedded version matches this column.
  sessionVersion Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Application relations
  tenantMemberships     TenantMember[]
  auditLogs             AuditLog[]
  tenantsCreated        Tenant[]              @relation("TenantCreatedBy")
  tenantsActivated      Tenant[]              @relation("TenantActivatedBy")
  tenantsSuspended      Tenant[]              @relation("TenantSuspendedBy")
  tenantStatusChanges   TenantStatusHistory[] @relation("TenantStatusChangedBy")
  subscriptionStatusChanges SubscriptionStatusHistory[] @relation("SubscriptionStatusChangedBy")
  supportGrantsReceived SupportAccessGrant[]  @relation("SupportGrantsReceived")
  supportGrantsIssued   SupportAccessGrant[]  @relation("SupportGrantsIssued")
  documentsIssued       Document[]            @relation("DocumentIssuedBy")
  documentsVoided       Document[]            @relation("DocumentVoidedBy")
  paymentsReversed      DocumentPayment[]     @relation("DocumentPaymentReversedBy")
  documentStatusEvents  DocumentStatusEvent[] @relation("DocumentStatusEventActor")
  syncOperations        SyncOperation[]
  // Contacts this user may read through the customer portal (usually at most one).
  portalContacts        Contact[]             @relation("ContactPortalAccess")
  // CRM & commerce (AGENT 02): lead ownership, task assignment, timeline actor.
  leadsAssigned         Lead[]
  tasksAssigned         Task[]
  activityEvents        ActivityEvent[]
  // Social commerce & marketing (AGENT 03): staff attribution on the inbox and
  // content surfaces. Each is its own named relation because User↔ContentPost
  // carries two distinct links (approver and creator).
  integrationConnections IntegrationConnection[] @relation("IntegrationConnectedBy")
  conversationsAssigned  Conversation[]   @relation("ConversationAssignedTo")
  messagesAuthored       ConversationMessage[] @relation("ConversationMessageAuthor")
  notesAuthored          ConversationNote[]    @relation("ConversationNoteAuthor")
  contentPostsApproved   ContentPost[]    @relation("ContentPostApprovedBy")
  contentPostsCreated    ContentPost[]    @relation("ContentPostCreatedBy")
  mediaAssetsUploaded    MediaAsset[]     @relation("MediaAssetUploadedBy")

  @@index([email])
  @@index([platformRole])
  @@index([sessionVersion])
}

// ─── Tenant Membership (many-to-many User ↔ Tenant) ──────────────────────────

model TenantMember {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String     @db.Uuid
  userId    String     @db.Uuid
  role      TenantRole @default(VIEWER)
  isDefault Boolean    @default(false) // Which tenant is active when user logs in
  joinedAt  DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId])
}

// ─── Invitations ──────────────────────────────────────────────────────────────
// Only a SHA-256 hash of the token is persisted; the raw token is sent via email.

model Invitation {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String           @db.Uuid
  email      String
  role       TenantRole       @default(VIEWER)
  tokenHash  String           @unique // SHA-256 hash of the invitation token
  status     InvitationStatus @default(PENDING)
  invitedBy  String           @db.Uuid // userId of inviter
  // The acceptance window is an instant — see the note on
  // SupportAccessGrant.expiresAt and migration 20261021000001.
  expiresAt  DateTime         @db.Timestamptz(3)
  acceptedAt DateTime?        @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tokenHash])
  @@index([tenantId])
  @@index([email])
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String?  @db.Uuid // null for system-level events
  userId            String?  @db.Uuid // null for system events
  action            String // e.g. "tenant.created", "user.invited", "invoice.approved"
  resource          String? // e.g. "Invoice", "User"
  resourceType      String? // e.g. "tenant", "user", "plan", "branding"
  resourceId        String? // ID of the affected record (polymorphic — intentionally not an FK)
  outcome           String? // e.g. "success", "failed", "denied"
  outcomeDetails    String? // Free-form summary of outcome
  correlationId     String? // Request ID or correlation identifier for tracking
  metadata          Json?   // Additional context (sanitised, no PII unless required)
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime @default(now())

  tenant            Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([correlationId])
  @@index([tenantId, createdAt(sort: Desc)], map: "AuditLog_tenantId_createdAt_idx")
}

// ─── Phase 06 server half: sync idempotency & tombstones ──────────────────────
//
// The push endpoint is idempotent by table, not by heuristic. `SyncOperation` is
// the receipt store: the unique key `(clientId, operationId)` is the client's own
// idempotency key, so a retry after a lost response answers the original outcome
// instead of applying the operation a second time. `outcome` is one of
// `applied | duplicate | rejected | conflict`; `revision` carries the row's
// revision for an `applied`/`duplicate`, `reason` the refusal text for a
// `rejected`, and `conflictId` names the disagreement for a `conflict`.
//
// `SyncDeletion` is a tombstone: a hard-deleted row that a device may still hold
// a copy of. The pull endpoint turns each tombstone into a `deleted` frame so the
// device drops the row instead of keeping a ghost record no one can explain.

model SyncOperation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String
  operationId String   @db.Uuid
  tenantId    String   @db.Uuid
  userId      String   @db.Uuid
  entity      String
  entityId    String
  outcome     String
  revision    Int?
  reason      String?
  conflictId  String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, operationId])
  @@index([tenantId, createdAt])
  @@index([userId])
}

model SyncDeletion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  entity      String
  entityId    String
  revision    Int
  deletedAt   DateTime @default(now())
  // Best-effort attribution. No FK: a tombstone must survive the deletion of the
  // actor, because the device still has to be told the row is gone.
  deletedById String?  @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, entity, entityId])
  @@index([tenantId, deletedAt])
}

// ─── Social commerce & marketing (AGENT 03 Phase 1) ───────────────────────────
//
// Governing rules from docs/implementation/orchestration/agent-03-design.md §2:
//
//   - Every table below carries a plain `tenantId` the RLS policy template keys
//     on directly; the junction (`ConversationLabel`) carries its own too.
//   - `IntegrationConnection` holds the encrypted credential
//     (`credentialCiphertext`, AES-256-GCM keyed on the `INTEGRATION_SECRET`
//     env). The secret itself never enters the database; only the ciphertext
//     and non-secret `credentialMeta` do. The API surface exposes neither the
//     ciphertext nor the raw token.
//   - `IntegrationWebhookEvent` and `MarketingEvent` are append-only (SELECT +
//     INSERT grants, a refuse-UPDATE/DELETE trigger), mirroring ActivityEvent.
//     A webhook row is created PARKED (tenantId NULL) and routed later; the
//     `(provider, eventId)` unique is the dedup spine Meta's retries demand.
//   - Drafting and publishing are separate objects: `ContentPost` (a draft that
//     walks DRAFT → APPROVED → SCHEDULED) and `PublishJob` (an attempt against
//     a provider). Nothing here claims a live publish; "PUBLISHED" is a state
//     only a verified job outcome sets in Phase 2.
//   - `MarketingEvent.contactId` is written ONLY when `Contact.marketingConsent`
//     is true (server-side rule, Phase 2); the `consented` column records which
//     branch an event took. `sourceMeta` holds de-identified referrer/device
//     class only — never an IP.

model IntegrationConnection {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId               String              @db.Uuid
  provider               IntegrationProvider
  status                 ConnectionStatus    @default(UNVERIFIED)
  // SHA-256 of the webhook verify token (never the raw token) — used by the
  // Meta handshake, mirroring Invitation.tokenHash.
  webhookVerifyTokenHash String?
  // AES-256-GCM ciphertext of the access token, keyed on INTEGRATION_SECRET.
  // bytea; the plaintext secret never touches this column.
  credentialCiphertext   Bytes?              @db.ByteA
  // Non-secret facts about the connection: phone_number_id, page_id,
  // instagram_user_id, token expiry instant, granted scopes.
  credentialMeta         Json?
  // The provider-side id a webhook routes on (phoneNumberId/pageId). Unique per
  // provider via the partial index the migration adds (invisible to Prisma).
  providerExternalId     String?
  lastHealthAt           DateTime?
  lastError              Json?
  connectedById          String?             @db.Uuid
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectedBy  User?                 @relation("IntegrationConnectedBy", fields: [connectedById], references: [id], onDelete: SetNull)
  conversations Conversation[]
  // Messages denormalise the connection id for the (connectionId,
  // providerMessageId) dedup unique; this is the back-relation for that FK.
  conversationMessages ConversationMessage[]
  publishJobs  PublishJob[]

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@index([tenantId, status])
}

model IntegrationWebhookEvent {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // NULL until routed to a tenant; a parked-but-authentic event carries none.
  tenantId      String?              @db.Uuid
  provider      IntegrationProvider
  deliveryId    String?
  // The dedup spine: Meta retries the same event id for up to 7 days. Required,
  // so the (provider, eventId) unique always holds.
  eventId       String
  payload       Json
  routingStatus WebhookRoutingStatus @default(PARKED)
  receivedAt    DateTime             @default(now())
  appliedAt     DateTime?
  createdAt     DateTime             @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, eventId])
  @@index([tenantId])
  @@index([provider, receivedAt])
}

model Conversation {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String              @db.Uuid
  connectionId     String              @db.Uuid
  channel          ConversationChannel
  // Provider-side conversation key (a phone number, a PSID, an IG-scoped id).
  // Unique per connection; the webhook upsert finds the thread by it.
  externalId       String
  contactId        String?             @db.Uuid
  leadId           String?             @db.Uuid
  status           ConversationStatus  @default(OPEN)
  assignedToUserId String?             @db.Uuid
  unreadCount      Int                 @default(0)
  lastInboundAt    DateTime?
  lastOutboundAt   DateTime?
  firstResponseAt  DateTime?
  closedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  contact        Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead           Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedToUser User?                @relation("ConversationAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages       ConversationMessage[]
  notes          ConversationNote[]
  labels         ConversationLabel[]

  @@unique([connectionId, externalId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, lastInboundAt])
  @@index([tenantId, contactId])
  @@index([tenantId, assignedToUserId])
}

model ConversationMessage {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String           @db.Uuid
  conversationId    String           @db.Uuid
  // Denormalised from the conversation so the `(connectionId, providerMessageId)`
  // dedup unique is expressible in the datamodel; a trigger keeps it consistent.
  connectionId      String           @db.Uuid
  direction         MessageDirection
  // Provider message id for idempotent inbound upsert; NULL for internally-
  // originated messages not yet acknowledged. NULLs are distinct, so the unique
  // is effectively partial.
  providerMessageId String?
  body              Json
  textPlain         String
  mediaRefs         Json?
  status            MessageStatus    @default(SENT)
  statusAt          DateTime?
  // Snapshot of the contact opt-out state at send time (server-side gate).
  optOutSnapshot    Boolean          @default(false)
  // Provenance seam only: marks a message that was composed from an AI draft.
  aiDraft           Boolean          @default(false)
  authorId          String?          @db.Uuid
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  connection   IntegrationConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  author       User?                  @relation("ConversationMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([connectionId, providerMessageId])
  @@index([tenantId])
  @@index([tenantId, conversationId])
  @@index([conversationId, createdAt])
}

model ConversationNote {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  conversationId String   @db.Uuid
  body           String
  authorId       String?  @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation("ConversationNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([conversationId, createdAt])
}

model Label {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  color     String?
  createdAt DateTime @default(now())

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationTags ConversationLabel[]

  // The migration additionally enforces case-insensitive uniqueness via a
  // functional unique index on lower(name) (same shape as Tag).
  @@unique([tenantId, name])
  @@index([tenantId])
}

// Junction table carrying its own tenantId for the RLS policy template; a
// migration trigger asserts the tenant matches both its conversation and its
// label (ContactTag precedent).
model ConversationLabel {
  tenantId       String   @db.Uuid
  conversationId String   @db.Uuid
  labelId        String   @db.Uuid
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@index([tenantId])
  @@index([labelId])
  @@index([tenantId, labelId])
}

model QuickReply {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  shortcut     String
  body         String
  position     Int
  // Provenance seam: true when the canned reply was AI-generated.
  aiProvenance Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, shortcut])
  @@index([tenantId])
  @@index([tenantId, position])
}

// Append-only marketing event stream (design spec §0: its own table, not
// ActivityEvent, for a different consent surface, volume and retention). The
// single `appendMarketingEvent` writer dedups via (tenantId, eventType,
// uniqueEventId) with P2002-swallow for retry-safety.
model MarketingEvent {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @db.Uuid
  eventType     MarketingEventType
  occurredAt    DateTime           @default(now())
  uniqueEventId String
  shareLinkId   String?            @db.Uuid
  campaignId    String?            @db.Uuid
  // Populated ONLY when Contact.marketingConsent is true; otherwise the event
  // stays de-identified (no contactId). `consented` records the branch.
  contactId     String?            @db.Uuid
  leadId        String?            @db.Uuid
  documentId    String?            @db.Uuid
  itemId        String?            @db.Uuid
  // Server-minted click id so a share-link retry never double-counts.
  clickId       String?
  // De-identified referrer/device class only — never an IP address.
  sourceMeta    Json?
  consented     Boolean            @default(false)
  createdAt     DateTime           @default(now())

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shareLink  ShareLink?         @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  campaign   MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contact    Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lead       Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  document   Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  item       Item?              @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@unique([tenantId, eventType, uniqueEventId])
  @@index([tenantId])
  @@index([tenantId, occurredAt])
  @@index([tenantId, campaignId])
  @@index([tenantId, shareLinkId])
  @@index([tenantId, contactId])
  @@index([tenantId, eventType])
}

model MarketingCampaign {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String         @db.Uuid
  name           String
  status         CampaignStatus @default(DRAFT)
  objective      String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  budgetCurrency String         @default("KES")
  // Informational budget, never an entitlement or a gate — mirrors Plan's
  // informational posture. Money CHECK floor mirrors Item_unitPrice_check.
  budgetAmount   Decimal?       @db.Decimal(18, 4)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shareLinks      ShareLink[]
  contentPosts    ContentPost[]
  marketingEvents MarketingEvent[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model ContentPost {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String              @db.Uuid
  campaignId    String?             @db.Uuid
  channel       ContentPostChannel
  kind          ContentKind
  title         String?
  body          String
  // Ordered MediaAsset ids this post references (JSON array, kept flexible).
  mediaAssetIds Json?
  status        ContentPostStatus   @default(DRAFT)
  approvedById  String?             @db.Uuid
  approvedAt    DateTime?
  // Our own queue is the scheduler (Instagram has no native scheduling).
  scheduledFor  DateTime?
  aiDraft       Boolean             @default(false)
  createdById   String?             @db.Uuid
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign    MarketingCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  approvedBy  User?              @relation("ContentPostApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy   User?              @relation("ContentPostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishJobs PublishJob[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, scheduledFor])
  @@index([tenantId, campaignId])
}

model PublishJob {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String             @db.Uuid
  contentPostId String             @db.Uuid
  connectionId  String             @db.Uuid
  attempt       Int                @default(1)
  maxAttempts   Int                @default(5)
  nextRetryAt   DateTime?
  status        PublishJobStatus   @default(QUEUED)
  // A provider reference from a VERIFIED outcome; its presence is the only
  // thing that can mark a post PUBLISHED. Never fabricated.
  providerRef   String?
  errorClass    PublishErrorClass?
  // Sanitised failure detail — never the raw credential or a provider secret.
  errorDetail   String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contentPost ContentPost           @relation(fields: [contentPostId], references: [id], onDelete: Cascade)
  connection  IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@unique([contentPostId, attempt])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([contentPostId])
  @@index([tenantId, connectionId])
  @@index([status, nextRetryAt])
}

model MediaAsset {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String         @db.Uuid
  // Vercel Blob seam read URL (fail-closed without BLOB_READ_WRITE_TOKEN); no
  // fake local storage — mirrors ItemImage.blobUrl.
  blobUrl      String
  alt          String?
  kind         MediaAssetKind
  bytes        Int?
  width        Int?
  height       Int?
  uploadedById String?        @db.Uuid
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  uploadedBy User?  @relation("MediaAssetUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, kind])
}
