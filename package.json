{
  "name": "amisibiz",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "description": "AmisiBiz — Production multi-tenant SaaS platform by Amisi Genuine Enterprises",
  "scripts": {
    "dev": "turbo run dev --filter=@amisibiz/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "pnpm --filter @amisibiz/web test",
    "test:run": "turbo run test:run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @amisibiz/web db:generate",
    "db:migrate": "pnpm --filter @amisibiz/web db:migrate",
    "db:migrate:deploy": "pnpm --filter @amisibiz/web db:migrate:deploy",
    "db:push": "pnpm --filter @amisibiz/web db:push",
    "db:studio": "pnpm --filter @amisibiz/web db:studio",
    "db:seed": "pnpm --filter @amisibiz/web db:seed",
    "db:assert-rls": "pnpm --filter @amisibiz/web db:assert-rls"
  },
  "devDependencies": {
    "eslint": "^9.26.0",
    "prettier": "^3.5.3",
    "turbo": "^2.11.8",
    "typescript": "^5.8.3"
  }
}
