# Dependencies
node_modules/

# Next.js
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# Turborepo
.turbo/

# Environment files - NEVER COMMIT THESE
.env
.env.local
.env.*.local
.env.development
.env.production

# Prisma
prisma/*.db
prisma/*.db-journal

# Tenant uploads — private business data, never commit
uploads/

# Local scratch and tooling — throwaway-cluster logs, migration probes and
# editor/agent state. These routinely contain hostnames and connection strings,
# so they are ignored rather than merely left unstaged.
.tmp/
.tmp/*
!.tmp/README*
.kilo/
.qoder/

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.vitest-results/
