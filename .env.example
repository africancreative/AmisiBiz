# AmisiBiz Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.

# ── Application ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AmisiBiz

# ── Tenant hostname routing ────────────────────────────────────
# Base domain for tenant workspaces: tenants are served from
# <slug>.<APP_BASE_DOMAIN> (e.g. acme.amisigenuine.com). NEVER hardcode this.
# Leave unset in local development (hostname routing is then disabled).
# APP_BASE_DOMAIN="amisigenuine.com"
# NEXT_PUBLIC_APP_BASE_DOMAIN="amisigenuine.com"
# Only trust X-Forwarded-Host behind a known reverse proxy / load balancer.
# TRUST_PROXY="false"

# ── Database (Supabase PostgreSQL) ─────────────────────────────
# Supabase → Project Settings → Database. Recommended Prisma setup: two URLs —
# the transaction pooler (port 6543, ?pgbouncer=true) for the app, and a
# session-mode connection (port 5432) for migrations. The pooler host also
# works from IPv4-only networks, where the direct db.[ref].supabase.co host
# (IPv6-only) is unreachable.
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Auth.js (NextAuth v5) ──────────────────────────────────────
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-min-32-chars-here"
# Local development only — on Vercel this is derived from VERCEL_URL.
AUTH_URL=http://localhost:3000
# Set to "true" on platforms where the host cannot be inferred (e.g. custom
# proxy setups / self-hosting). Not required on Vercel.
# AUTH_TRUST_HOST="true"

# ── OAuth Providers (optional) ─────────────────────────────────
# AUTH_GOOGLE_ID="your-google-client-id"
# AUTH_GOOGLE_SECRET="your-google-client-secret"

# ── Supabase Storage (optional, for document uploads) ──────────
# Publishable keys (sb_publishable_*) are browser-safe and may appear in the
# client bundle. Secret keys (sb_secret_*) are server-only — never expose them
# to the client bundle, logs or error messages.
# NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# SUPABASE_SECRET_KEY="sb_secret_..."

# ── Email (required before enabling production registration) ───
# No transport is implemented yet. When EMAIL_PROVIDER is unset, email
# verification and password-reset messages are NOT delivered.
# EMAIL_PROVIDER="smtp"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="noreply@example.com"
# SMTP_PASSWORD="your-smtp-password"
# EMAIL_FROM="AmisiBiz <noreply@amisibiz.com>"

# ── Authentication policy ──────────────────────────────────────
# Enforce email verification at sign-in. Requires a working EMAIL_PROVIDER.
# REQUIRE_EMAIL_VERIFICATION="false"

# ── Seed (optional — platform admin bootstrap) ─────────────────
# Never commit real values. The seed does nothing unless these are set.
# SEED_PLATFORM_ADMIN_EMAIL="admin@example.com"
# SEED_PLATFORM_ADMIN_PASSWORD="a-strong-unique-password-min-12-chars"
# SEED_PLATFORM_ADMIN_NAME="Platform Admin"
# ALLOW_PROD_SEED="false"
