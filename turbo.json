{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_APP_NAME",
    "NEXT_PUBLIC_APP_BASE_DOMAIN",
    "APP_BASE_DOMAIN",
    "TRUST_PROXY",
    "DATABASE_URL",
    "DIRECT_URL",
    "DATABASE_URL_UNPOOLED",
    "APP_DATABASE_URL",
    "PGHOST",
    "PGHOST_UNPOOLED",
    "PGUSER",
    "PGDATABASE",
    "PGPASSWORD",
    "POSTGRES_URL",
    "POSTGRES_URL_NON_POOLING",
    "POSTGRES_USER",
    "POSTGRES_HOST",
    "POSTGRES_PASSWORD",
    "POSTGRES_DATABASE",
    "POSTGRES_URL_NO_SSL",
    "POSTGRES_PRISMA_URL",
    "AUTH_SECRET",
    "AUTH_URL",
    "REQUIRE_EMAIL_VERIFICATION",
    "NEON_REALTIME_SECRET",
    "NEON_AUTH_BASE_URL",
    "NEON_REALTIME_URL",
    "VITE_NEON_AUTH_URL",
    "NEON_PROJECT_ID",
    "VERCEL",
    "VERCEL_URL",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "VERCEL_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "type-check": {},
    "test:run": {
      "dependsOn": []
    }
  }
}
